{
  "name": "jindu-personal-planner",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types backend/app.ts",
    "worker": "node --experimental-strip-types backend/worker.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node --experimental-strip-types deploy/portable/smoke.mjs",
    "test:workbooks": "python tests/job-workbooks-v10.py",
    "test:upgrade": "python tests/upgrade-v15.py"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Self-hosted personal planner with calendars, recruitment tracking and AI assistance.",
  "license": "MIT",
  "author": "deyuetian",
  "repository": {
    "type": "git",
    "url": "https://github.com/deyuetian/jindu.git"
  },
  "bugs": {
    "url": "https://github.com/deyuetian/jindu/issues"
  },
  "homepage": "https://github.com/deyuetian/jindu#readme"
}
